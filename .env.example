# Runtime
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vetra
FRONTEND_URL=http://localhost:3005

# Invoice extraction
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-4.1-mini
INVOICE_MAX_FILE_SIZE=10485760

# Invoice documents. The bucket must already exist and be private.
INVOICE_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
SUPABASE_INVOICES_BUCKET=vetra-invoices

# Dish photos of the menu (carta). Unlike the invoices this bucket must be PUBLIC: the restaurant's website shows them.
# MENU_STORAGE_PROVIDER defaults to supabase in production and local (MENU_STORAGE_DIR) in development.
SUPABASE_MENU_BUCKET=vetra-menu

# Optional local provider for development only
# INVOICE_STORAGE_PROVIDER=local
# INVOICE_STORAGE_DIR=./storage/invoices

# Vetra AI (ai-service, see docs/VETRA_AI_ARCHITECTURE.md)
# Shared secret ai-service sends as X-Service-Token on /api/internal/ai/*
AI_SERVICE_TOKEN=
# RS256 keypair for the agent-context JWT. Node holds BOTH (it mints and
# also verifies tokens ai-service forwards back on /api/internal/ai/*).
# ai-service only ever gets AI_SERVICE_JWT_PUBLIC_KEY — never the private key —
# so a compromised ai-service cannot forge a token (asymmetric on purpose,
# not a shared HMAC secret). Generate with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt
#   openssl rsa -in <private.pem> -pubout
AI_SERVICE_JWT_PRIVATE_KEY=
AI_SERVICE_JWT_PUBLIC_KEY=
